# Contact form delivery (app/api/contact/route.js)
# Copy to .env.local and fill in. Without RESEND_API_KEY and CONTACT_FROM_EMAIL
# the form answers 503 and asks visitors to email the studio directly.

# API key from https://resend.com/api-keys (needs "Sending access").
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "SPRDLX <contact@sprdlx.co>".
CONTACT_FROM_EMAIL=

# Inbox that receives enquiries. Optional: defaults to site.contactEmail in data/site.js.
CONTACT_TO_EMAIL=

# Canonical origin used for canonicals, sitemap, Open Graph and structured data.
# Defaults to https://www.sprdlx.co (sprdlx.co redirects there). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Search console verification tokens (optional). Only the token value, not the whole tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
